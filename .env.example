# Mẫu biến môi trường cho BE và stream. Sao chép thành .env rồi điền giá trị thực.
# run_video.py và run_stream.py tự nạp .env; biến môi trường đã đặt sẽ được ưu tiên.

# API key gửi BE qua header x-api-key; bắt buộc khi bật --upload.
TPV_UPLOAD_API_KEY=

# URL stream tuỳ chọn, ưu tiên hơn nguồn trong configs/stream.yaml.
# Để trống để dùng nguồn YAML; điền URL RTMP hoặc playlist HLS .m3u8 nếu muốn ghi đè.
# Ví dụ: rtmp://camera-host/live/stream?user=USERNAME&pass=PASSWORD
UAV_STREAM_URL=

# Tuỳ chọn: URL publish RTMP đầy đủ, gồm query auth nếu server yêu cầu.
UAV_VIZ_URL=
